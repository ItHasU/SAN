# Modèle de configuration de production (docker-compose.yml).
#   cp .env.prod.example .env     # .env est ignoré par git : ne jamais le commiter
#   chmod 600 .env

# -- Image --
# Tag publié par la CI : nom de branche (/ remplacé par -), `latest` sur main, ou sha-xxxxxxx.
SAN_IMAGE_TAG=latest

# -- URL publique --
# Adresse réelle d'accès (HTTPS, via le reverse proxy). Sert à construire les liens absolus.
APP_BASE_URL=https://agents.example.org

# -- Réseau --
# Nom du réseau Docker externe partagé avec le reverse proxy (docker network ls).
PROXY_NETWORK=proxy
# Variante standalone uniquement : port publié sur l'hôte.
PUBLISHED_PORT=3000
# Nombre de proxys de confiance devant le serveur (1 avec un reverse proxy, 0 sans).
SAN_TRUST_PROXY=1

# -- Base de données --
DB_USER=san
DB_NAME=san
# OBLIGATOIRE : choisir un mot de passe fort (ex. : openssl rand -base64 24 | tr -d '/+=')
DB_PASSWORD=

# -- Secret --
# OBLIGATOIRE : 32 octets en base64. Protège les secrets stockés en base ; le serveur
# refuse de démarrer sans. À sauvegarder : le perdre rend ces secrets illisibles.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#   ou : openssl rand -base64 32
APP_SECRET=

# -- Limites SAN (optionnel, valeurs par défaut) --
#SAN_REGISTER_RATE_PER_HOUR=5
#SAN_MAX_PENDING=20
