# Configuration d'amorçage, lue dans l'environnement (Dagda FEATURES §11.5).

# -- Serveur HTTP --
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

# -- Base de données (PostgreSQL local, DESIGN §9) --
APP_DATABASE_URL=postgresql://dagda:dagda@localhost:5432/san

# -- Secrets --
# Obligatoire : 32 octets en base64. Le serveur refuse de démarrer sans.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# -- SAN (DESIGN §6) --
# Limite de demandes d'enrôlement par heure et par IP (POST /device/register)
SAN_REGISTER_RATE_PER_HOUR=5
# Plafond de viewers en attente d'activation
SAN_MAX_PENDING=20
# Nombre de proxys de confiance devant le serveur (express "trust proxy")
SAN_TRUST_PROXY=1
# Répertoire des fichiers audio (phase suivante)
DATA_DIR=./data
