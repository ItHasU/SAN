# Configuration d'amorçage, lue dans l'environnement (Dagda FEATURES §11.5).

# -- Serveur HTTP --
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

# -- Base de données (PostgreSQL local, DESIGN §9) --
APP_DATABASE_URL=postgresql://dagda:dagda@localhost:5432/san

# -- Secrets --
# Obligatoire : 32 octets en base64. Le serveur refuse de démarrer sans.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# -- SAN (DESIGN §6) --
# Limite de demandes d'enrôlement par heure et par IP (POST /device/register)
SAN_REGISTER_RATE_PER_HOUR=5
# Plafond de viewers en attente d'activation
SAN_MAX_PENDING=20
# Enrôlement des agents (POST /agent/register) : par heure et par IP sans jeton d'enrôlement (pending)
SAN_AGENT_REGISTER_RATE_PER_HOUR=5
# ... avec un jeton d'enrôlement valide
SAN_AGENT_ENROLL_RATE_PER_HOUR=60
# Plafond d'agents en attente d'approbation
SAN_MAX_PENDING_AGENTS=20
# Nombre de proxys de confiance devant le serveur (express "trust proxy")
SAN_TRUST_PROXY=1
# Répertoire des fichiers audio (clips et conversions)
DATA_DIR=./data
# Synthèse vocale : piper (service HTTP, TTS_URL requis) ou fake (bip, tests/dev).
# Par défaut piper si TTS_URL est défini, sinon fake.
#TTS_ENGINE=fake
#TTS_URL=http://localhost:5000
# Chemins de ffmpeg / ffprobe s'ils ne sont pas dans le PATH
#FFMPEG_PATH=/usr/bin/ffmpeg
#FFPROBE_PATH=/usr/bin/ffprobe
